{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrfcoin.org/schemas/deployment-manifest-v1.json",
  "title": "WRFCoin release deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "network",
    "deployer",
    "sourceRevision",
    "createdAt",
    "contracts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "network": { "type": "string", "minLength": 1 },
    "deployer": { "$ref": "#/$defs/address" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "contracts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/deployment" }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "transactionHash",
        "blockNumber",
        "artifactHash",
        "dependencies"
      ],
      "properties": {
        "name": {
          "enum": [
            "WRFToken",
            "WRFTokenTestnet",
            "QualityOracle",
            "ProofOfPublishing",
            "WeatherDataValidator",
            "RewardDistributor",
            "CommunityGovernance",
            "NFTMarketplace",
            "ComputationalNFT"
          ]
        },
        "address": { "$ref": "#/$defs/address" },
        "transactionHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "artifactHash": { "$ref": "#/$defs/hash" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/address" }
        }
      }
    }
  },
  "x-releaseInventory": [
    { "name": "WRFToken", "dependencies": [] },
    { "name": "WRFTokenTestnet", "dependencies": [] },
    { "name": "QualityOracle", "dependencies": [] },
    { "name": "ProofOfPublishing", "dependencies": [] },
    { "name": "WeatherDataValidator", "dependencies": [] },
    { "name": "RewardDistributor", "dependencies": ["QualityOracle"] },
    { "name": "CommunityGovernance", "dependencies": [] },
    { "name": "NFTMarketplace", "dependencies": ["WRFToken"] },
    {
      "name": "ComputationalNFT",
      "dependencies": ["WRFToken", "WeatherDataValidator"]
    }
  ]
}
