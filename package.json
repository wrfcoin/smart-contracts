{
  "name": "@wrfcoin/contracts",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/wrfcoin/smart-contracts",
  "description": "Smart contracts for WRFCoin platform",
  "overrides": {
    "tmp": ">=0.2.4",
    "diff": ">=8.0.3",
    "external-editor": {
      "tmp": ">=0.2.4"
    }
  },
  "scripts": {
    "compile": "hardhat --config ./hardhat.config.js compile",
    "test": "hardhat --config ./hardhat.config.js test",
    "coverage": "hardhat --config ./hardhat.config.js coverage",
    "coverage:inventory": "node scripts/generate-coverage-inventory.js",
    "test:coverage": "hardhat --config ./hardhat.config.js coverage",
    "test:security": "node ./test/run-dos-security-tests.js",
    "test:performance": "node ./test/run-performance-benchmarks.js",
    "test:comprehensive": "node ./test/run-comprehensive-tests.js",
    "deploy": "hardhat --config ./hardhat.config.js run scripts/deploy.js --network hardhat",
    "deploy:dry-run": "hardhat --config ./hardhat.config.js run scripts/deploy.js --network hardhat",
    "deploy:testnet": "node scripts/parked-native-testnet.js",
    "deploy:evm:experimental": "hardhat --config ./hardhat.config.js run scripts/deploy.js --network external_evm",
    "deploy:local": "hardhat --config ./hardhat.config.js run scripts/deploy.js --network testnet_local",
    "keeper:liquidation-commits": "node scripts/expire-liquidation-commits.js",
    "testnet:deploy": "node scripts/parked-native-testnet.js",
    "testnet:monitor": "node testnet-security-monitoring.js",
    "testnet:verify": "node testnet-formal-verification.js",
    "testnet:full": "node scripts/parked-native-testnet.js",
    "evm:experimental:full": "npm run deploy:evm:experimental && npm run testnet:monitor && npm run static:analyze",
    "security:audit": "npm run test:security && npm run test:performance",
    "security:monitor": "node testnet-security-monitoring.js --start",
    "security:report": "node testnet-security-monitoring.js --report",
    "security": "slither .",
    "formal:verify": "echo 'renamed: static:analyze (Slither static analysis, not formal verification)' && exit 1",
    "static:analyze": "node testnet-formal-verification.js",
    "static:analyze:quick": "node testnet-formal-verification.js --quick",
    "formal:governance": "hardhat --config ./hardhat.config.js test test/FormalVerificationSpecs.test.js",
    "formal:market": "hardhat --config ./hardhat.config.js test test/CarbonCreditMarketFormalVerification.test.js",
    "formal:artifacts": "node scripts/export-formal-verification-artifact.js",
    "formal:artifacts:market": "node scripts/export-carbon-credit-market-formal-verification-artifact.js",
    "audit:prepare": "npm run compile && npm run test:comprehensive && npm run static:analyze",
    "audit:package": "echo 'audit:package retired; use npm run audit:prepare for real validation artifacts' && exit 1",
    "gas:analyze": "hardhat test --gas-reporter",
    "type-check": "echo 'No TypeScript files to check in contracts workspace'",
    "lint": "solhint '**/*.sol' --ignore-path .solhintignore",
    "lint:config": "node scripts/check-solhint-plugin-consistency.js",
    "lint:claims": "node scripts/check-readiness-claims.js",
    "lint:fix": "solhint '**/*.sol' --fix",
    "format": "prettier --write '**/*.sol'",
    "format:check": "prettier --check '**/*.sol'",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "console": "hardhat console",
    "performance": "./run-performance-benchmarks.sh",
    "performance:quick": "./quick-performance-test.sh",
    "performance:setup": "./test/setup-performance-benchmarks.sh",
    "dos:test": "hardhat test test/DOSSecurityTestSuite.test.js",
    "benchmark": "hardhat test test/PerformanceBenchmarker.test.js",
    "size:check": "hardhat size-contracts",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^10.0.10",
    "chai": "^4.2.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.24.3",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "mocha": "^10.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "1.3.1",
    "solhint": "^5.1.0",
    "solhint-plugin-prettier": "0.1.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.6.0",
    "@chainlink/contracts": "^1.4.0",
    "@nomicfoundation/solidity-analyzer-linux-x64-gnu": "^0.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@arbitrum/nitro-contracts": {
      "@openzeppelin/contracts": "4.9.6",
      "@openzeppelin/contracts-upgradeable": "4.9.6"
    },
    "@offchainlabs/upgrade-executor": {
      "@openzeppelin/contracts": "4.9.6",
      "@openzeppelin/contracts-upgradeable": "4.9.6"
    }
  }
}
