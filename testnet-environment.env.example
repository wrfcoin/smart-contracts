# ============================================================
# WRFCoin Testnet Environment Configuration
# ============================================================
# SETUP:
#   1. Copy this file: cp testnet-environment.env.example testnet-environment.env
#   2. Fill in your actual values below
#   3. NEVER commit testnet-environment.env — it is gitignored
# ============================================================

# WRFCoin Testnet Environment Configuration
# Task 99.18 - Comprehensive Testnet Deployment and Validation Framework
#
# This file contains environment variables required for testnet deployment,
# security monitoring, and validation of the DoS vulnerability fixes.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Primary testnet network (Sepolia recommended for production-like testing)
NETWORK=sepolia
HARDHAT_NETWORK=sepolia

# RPC URLs for different networks
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_API_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_API_KEY

# Infura/Alchemy API keys for RPC access
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================

# Private key for deployment (TESTNET ONLY - DO NOT USE MAINNET KEYS)
PRIVATE_KEY=your_testnet_private_key_here

# Mnemonic for local development (default Hardhat mnemonic)
MNEMONIC=test test test test test test test test test test test junk

# =============================================================================
# CONTRACT VERIFICATION
# =============================================================================

# Etherscan API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# =============================================================================
# SECURITY MONITORING CONFIGURATION
# =============================================================================

# Enable/disable security monitoring features
ENABLE_MONITORING=true
MONITORING_INTERVAL=5000
REAL_TIME_ALERTS=true

# Alert channels configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_EMAIL=security-alerts@wrfcoin.com
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# Gas monitoring thresholds
MAX_GAS_PER_OPERATION=15000000
DOS_DETECTION_THRESHOLD=0.8
BLOCK_GAS_UTILIZATION_ALERT=0.8

# Economic security thresholds
MAX_TVL_PROTECTION=30000000
MIN_ATTACK_COST=1000000
ECONOMIC_ATTACK_THRESHOLD=1000000

# =============================================================================
# FORMAL VERIFICATION CONFIGURATION
# =============================================================================

# Enable formal verification tools
RUN_FORMAL_VERIFICATION=true
FORMAL_VERIFICATION_TIMEOUT=300
ENABLE_SLITHER=true
ENABLE_MYTHRIL=false
ENABLE_ECHIDNA=true
ENABLE_MANTICORE=false

# Verification tool configurations
SLITHER_DETECTORS=all
MYTHRIL_TIMEOUT=300
ECHIDNA_TESTS=10000

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test execution parameters
SKIP_VALIDATION=false
RUN_DOS_TESTS=true
RUN_PERFORMANCE_TESTS=true
RUN_GAS_ANALYSIS=true

# Test coverage requirements
MIN_TEST_COVERAGE=0.95
MAX_GAS_USAGE_TEST=30000000

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment parameters
GENERATE_AUDIT_PACKAGE=true
SAVE_DEPLOYMENT_ARTIFACTS=true
VERIFY_ON_DEPLOYMENT=true

# Contract initialization parameters
GOVERNANCE_MAX_TVL_PROTECTION=30000000
GOVERNANCE_MIN_PROPOSER_REPUTATION=1000
GOVERNANCE_PROPOSER_BOND=10000000000000000000000
GOVERNANCE_SLASHING_PERCENTAGE=30

NFT_MARKETPLACE_MAX_ROYALTY_RECIPIENTS=20
NFT_MARKETPLACE_MAX_GAS_PER_LISTING=15000000
NFT_MARKETPLACE_ROYALTY_FEE_LIMIT=1000

ECONOMIC_ENGINE_MIN_ATTACK_COST=1000000
ECONOMIC_ENGINE_EMERGENCY_THRESHOLD=5000000

# =============================================================================
# GAS REPORTING CONFIGURATION
# =============================================================================

# Gas reporter settings
GAS_REPORTER_ENABLED=true
GAS_REPORTER_CURRENCY=USD
GAS_REPORTER_OUTPUT_FILE=./test-reports/gas-consumption/gas-report.txt
GAS_PRICE_USD=20

# =============================================================================
# PERFORMANCE BENCHMARKING
# =============================================================================

# Performance testing parameters
PERFORMANCE_TEST_ITERATIONS=1000
MAX_ROYALTY_RECIPIENTS_TEST=1000
MAX_PROPOSALS_TEST=10000
BENCHMARK_TIMEOUT=600000

# DoS resistance testing
DOS_TEST_GAS_LIMIT=30000000
DOS_TEST_MAX_RECIPIENTS=1000
DOS_TEST_MAX_PROPOSALS=10000

# =============================================================================
# SECURITY AUDIT PREPARATION
# =============================================================================

# External auditor configuration
PREPARE_AUDIT_ENVIRONMENT=true
GENERATE_DOCUMENTATION=true
CREATE_AUDIT_PACKAGE=true
FREEZE_CODE_FOR_AUDIT=true

# Audit deliverable settings
AUDIT_REPORT_FORMAT=json,markdown
INCLUDE_TEST_RESULTS=true
INCLUDE_PERFORMANCE_METRICS=true
INCLUDE_FORMAL_VERIFICATION=true

# =============================================================================
# LOGGING AND DEBUGGING
# =============================================================================

# Debug settings
DEBUG_MODE=true
VERBOSE_LOGGING=true
SAVE_TRANSACTION_TRACES=true
LOG_LEVEL=info

# Log file paths
SECURITY_LOG_PATH=./test-reports/security-monitoring/security.log
DEPLOYMENT_LOG_PATH=./test-reports/testnet-deployment/deployment.log
PERFORMANCE_LOG_PATH=./test-reports/performance-benchmarking/performance.log

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================

# Emergency response settings
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=0.9
EMERGENCY_PAUSE_ENABLED=true
AUTO_RECOVERY_ENABLED=false

# =============================================================================
# DEVELOPMENT ENVIRONMENT SETTINGS
# =============================================================================

# Local development configuration
LOCAL_HARDHAT_NODE=true
LOCAL_CHAIN_ID=1337
LOCAL_BLOCK_TIME=3
LOCAL_GAS_LIMIT=30000000
LOCAL_GAS_PRICE=8000000000

# Account configuration for testing
TEST_ACCOUNT_COUNT=100
TEST_ACCOUNT_BALANCE=10000000000000000000000000

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# IPFS configuration (for metadata storage)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Oracle configuration (for price feeds)
CHAINLINK_ORACLE_ENABLED=true
PRICE_FEED_ADDRESS=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# =============================================================================
# NOTES FOR USAGE
# =============================================================================

# 1. Copy this file to .env in the contracts directory
# 2. Replace all placeholder values with your actual API keys and configuration
# 3. NEVER commit .env files to version control
# 4. Use different .env files for different environments (development, staging, production)
# 5. Ensure all required API keys are configured before running testnet deployment
# 6. Test with small amounts first before full deployment
# 7. Monitor gas prices and network congestion before deployment
# 8. Verify all contract addresses after deployment
# 9. Run comprehensive security tests before moving to mainnet
# 10. Keep backups of all deployment artifacts and private keys

# =============================================================================
# SECURITY REMINDERS
# =============================================================================

# - This configuration is for TESTNET ONLY
# - Never use mainnet private keys in testnet configuration
# - Rotate keys regularly
# - Use hardware wallets for mainnet deployment
# - Monitor for unusual activity during testing
# - Test all emergency procedures
# - Validate all security fixes before deployment
# - Document all changes and decisions
# - Maintain audit trail of all activities
# - Follow principle of least privilege for access control